<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Drugie Okno"
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="Warsztat" FontSize="32" FontWeight="Bold" Foreground="DodgerBlue" HorizontalAlignment="Center" />
        <Button Content="Kliknij mnie" HorizontalAlignment="Center" />
        <TextBox Watermark="Wpisz cos tutaj..." Width="300" HorizontalAlignment="Center" />
        <Slider Minimum="0" Maximum="100" Value="50" Width="300" HorizontalAlignment="Center" />
        <CheckBox Content="Zgadzam sie" HorizontalAlignment="Center" />
        <TextBlock Text="Autor: Tymek Junak" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
